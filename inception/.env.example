# Example .env for the Inception project
# Copy this to .env and fill secrets locally (do NOT commit .env with real secrets).

# Data directory path - will be automatically set by setup.sh to $HOME/data
# On a fresh VM, this should be something like /home/username/data
USER_DATA_PATH=/home/username/data

DOMAIN_NAME=localhost

DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=your_db_password_here
DB_ROOT_PASSWORD=your_root_password_here

WP_TITLE=My WordPress
WP_ADMIN=admin
WP_ADMIN_PASSWORD=your_wp_admin_password_here
WP_ADMIN_EMAIL=admin@example.com
WP_URL=https://localhost